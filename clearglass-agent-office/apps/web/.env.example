# Copy to .env.local for local development. Never commit real values.
# Where the FastAPI service runs. Leave unset to render the committed offline snapshot.
OFFICE_API_URL=http://127.0.0.1:8000
# Operator token for the API. Server-side only: never prefixed with NEXT_PUBLIC_.
OFFICE_API_TOKEN=
# Console sign-in. When both are set, every page and action requires the passphrase.
OFFICE_CONSOLE_PASSPHRASE=
OFFICE_SESSION_SECRET=
# production: refuse actions unless the passphrase and session secret are set.
OFFICE_ENV=development
